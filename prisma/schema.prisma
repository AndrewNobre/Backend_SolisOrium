// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id String @id @default(uuid())
  nome String
  email String @unique
  senha String
  tokensRecuperacaoSenha TokenRecuperacaoSenha[]
  reservas Reserva[]
  telefone String @unique
  createdAT DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TokenRecuperacaoSenha {
  id String @id @default(uuid())

  // Apenas o hash do token é persistido no banco.
  tokenHash String @unique

  expiraEm DateTime
  usadoEm   DateTime?

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum StatusPontoRecarga {
  DISPONIVEL
  OCUPADO
}

model PontoRecarga {
  id String @id @default(uuid())
  reservas Reserva[]

  nome     String
  endereco String

  // Localização informada no cadastro do ponto.
  latitudeCadastrada  Decimal @db.Decimal(10, 7)
  longitudeCadastrada Decimal @db.Decimal(10, 7)

  // Localização mais recente recebida do dispositivo IoT.
  latitudeDetectada  Decimal? @db.Decimal(10, 7)
  longitudeDetectada Decimal? @db.Decimal(10, 7)

  status StatusPontoRecarga @default(DISPONIVEL)

  // Permite saber quando foi a última informação enviada pelo dispositivo.
  statusAtualizadoEm       DateTime?
  localizacaoAtualizadaEm  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StatusReserva {
  ATIVA
  CANCELADA
  EXPIRADA
}

model Reserva {
  id String @id @default(uuid())
  usuarioId String
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pontoRecargaId String
  pontoRecarga PontoRecarga @relation(fields: [pontoRecargaId], references: [id], onDelete: Restrict)
  status StatusReserva @default(ATIVA)
  expiraEm DateTime
  canceladaEm DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId, createdAt])
  @@index([pontoRecargaId, status, expiraEm])
  @@unique([pontoRecargaId], map: "Reserva_ponto_ativo_key", where: raw("\"status\" = 'ATIVA'"))
}
